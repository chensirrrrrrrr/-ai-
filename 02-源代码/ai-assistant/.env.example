# ---------- 基础 ----------
APP_NAME=留学机构 AI 智能助手系统
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ---------- 跨域（前后端分离部署必配） ----------
# 前端页面所在的 origin，逗号分隔。debug=true 时此项被忽略（全放通）。
# 8020 是本项目自带前端服务 scripts/serve_frontend.py 的默认端口。
CORS_ORIGINS=http://127.0.0.1:8020,http://localhost:8020,http://127.0.0.1:5173,http://localhost:5173

# ---------- 安全（生产必须换掉，长度 >= 32 字节） ----------
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=120
TOOL_SHARED_SECRET=dev-only-tool-secret-change-me-0123456789

# ---------- 数据库 ----------
# 开发：SQLite（零依赖，文件即库）
DATABASE_URL=sqlite:///./data/ai_assistant.db
# 生产：MySQL 8（需先 pip install -r requirements-mysql.txt）
# DATABASE_URL=mysql+pymysql://uas:password@127.0.0.1:3306/ai_assistant?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------- Dify（Agent 编排） ----------
# mock = 不连 Dify，用内置确定性应答（本地开发 / 单元测试）
#        对话仍能真查库 / 真落库，由 services/mock_agent.py 编排
# live = 真实调用 Dify API（**7 个应用的 Key 都要配齐**，配一半会静默降级）
#
# 切换步骤：
#   1) 把 DIFY_BASE_URL 指向你的 Dify 服务 API 地址（**注意要带 /v1**）
#      本机自托管通常就是 http://127.0.0.1/v1（官方 docker compose 默认 80 端口）
#   2) 在 Dify 控制台为下面 7 个应用各建一个「API 访问」Key，填进 DIFY_APP_KEYS
#   3) python scripts/check_dify.py   ← 逐个探活，确认真的通
#   4) 确认全部 [OK] 后，再把 DIFY_MODE 改成 live 并重启
DIFY_MODE=mock
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_TIMEOUT=30
DIFY_MAX_RETRIES=2

# 是否沿用系统代理（HTTP_PROXY / HTTPS_PROXY）连 Dify。
# 留空 = 自动：本机/内网地址（127.0.0.1、localhost、10./172.16-31./192.168.、
# host.docker.internal）绕开代理，公网地址沿用代理。
# ⚠️ 如果你设置了全局代理（Windows 的"系统代理"或 HTTP_PROXY 环境变量），
#    本机 Dify 会被代理接走 → 请求返回 502 → 又被降级逻辑吞掉变成 mock 回答，
#    从界面上完全看不出问题。此时设为 false 即可。
# DIFY_TRUST_ENV_PROXY=false

# 每个 Dify 应用一个 key，按用途分开，便于灰度与降级。
# 应用名固定为：router / customer_service / student_helper /
#               enterprise_assistant / mental_care / screener / reporter
# 两种写法都支持（下面的 k=v 形式更少打错引号）：
# DIFY_APP_KEYS={"router":"app-xxxxxxxx","customer_service":"app-yyyyyyyy"}
# DIFY_APP_KEYS=router=app-xxxxxxxx,customer_service=app-yyyyyyyy,student_helper=app-zzz,enterprise_assistant=app-aaa,mental_care=app-bbb,screener=app-ccc,reporter=app-ddd

# ---------- 语音录入 ----------
ASR_PROVIDER=mock
ASR_MAX_BYTES=10485760

# ---------- 业务开关 ----------
NL2SQL_MAX_ROWS=50
NL2SQL_WHITELIST_ENABLED=true
